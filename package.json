{
  "name": "poe-item-search",
  "version": "2.7.1",
  "description": "Paste your item on PoE Trade website and start searching for it!",
  "main": "dist/content.js",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "BUILD_MODE=dev vite build",
    "build": "vite build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook --browsers chromium --maxWorkers 2 --failOnConsole",
    "test:ui": "bun run build-storybook && start-server-and-test \"http-server storybook-static --port 6007 --address 127.0.0.1 --silent\" http-get://127.0.0.1:6007/index.json \"bun run test-storybook --url http://127.0.0.1:6007 --ci\"",
    "test": "bun test",
    "package": "bun scripts/package.js",
    "update-stats": "bun scripts/fetch-stats.js",
    "generate-tiers": "bun scripts/generate-tier-data.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "check": "bun run lint && bun run typecheck && bun test"
  },
  "author": "Daniel Griesser",
  "license": "MIT",
  "overrides": {
    "uuid": "11.1.1"
  },
  "dependencies": {
    "@sentry/browser": "^10.73.0",
    "lz-string": "^1.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@storybook/test-runner": "^0.24.5",
    "@types/bun": "^1.4.1",
    "@types/chrome": "^0.2.9",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.5.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "http-server": "^14.1.1",
    "postcss": "^8.5.28",
    "start-server-and-test": "^3.0.12",
    "storybook": "10.6.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  }
}
